{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/realtime/ws",
      "destination": "/api/realtime-ws"
    },
    {
      "source": "/realtime/:path*",
      "destination": "https://weizend-realtime.weizendtv.workers.dev/:path*"
    },
    {
      "source": "/:path*",
      "destination": "https://weizend-botrix.weizendtv.workers.dev/:path*"
    }
  ]
}
